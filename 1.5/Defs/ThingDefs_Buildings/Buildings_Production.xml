<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    <ThingDef ParentName="TBW_ProductionBase" >
        <defName>TBW_Hydroponic_Chamber</defName>
        <label>Hydroponic chamber</label>
        <description>Large hydroponic crop growth facility.</description>
        <statBases>
        <MaxHitPoints>600</MaxHitPoints>
        <Flammability>0.6</Flammability>
        <Mass>100</Mass>
        <Beauty>0</Beauty>
        <WorkToBuild>12000</WorkToBuild>
        </statBases>
        <graphicData>
            <texPath>Things/Building/Production/HydroponicsBasin</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(4,4)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <size>(2,4)</size>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="TBW.CompProperties_TBW_MultiPawnsHolder">
                <baseMaxPawnNum>4</baseMaxPawnNum>
                <isSuspended>true</isSuspended>
            </li>
            <li Class="TBW.CompProperties_TBW_Production">
                <spawnList>
                    <li>
                        <spawnDef>RawPotatoes</spawnDef>
                        <output>800</output>
                        <outputAddPerPawn>400</outputAddPerPawn>
                    </li>
                </spawnList>
                <tickstoSpawnDefault>720000</tickstoSpawnDefault>
                <requiresPower>true</requiresPower>
            </li>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>false</shortCircuitInRain>
                <basePowerConsumption>1200</basePowerConsumption>
            </li>
        </comps>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    </ThingDef>

</Defs>
