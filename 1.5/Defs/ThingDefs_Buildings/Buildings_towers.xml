            </shadowData>
        </graphicData>
        <thingClass>TBW.Building_TBW_Security</thingClass>
        
        <stuffCategories Inherit="false">
            
        </stuffCategories>
        <damageMultipliers>
            <li>
                <damageDef>Bullet</damageDef>
                <multiplier>0.5</multiplier>
            </li>
            <li>
                <damageDef>Cut</damageDef>
                <multiplier>0.2</multiplier>
            </li>
            <li>
                <damageDef>Stab</damageDef>
                <multiplier>0.2</multiplier>
            </li>
        </damageMultipliers>
        <statBases>
            <MaxHitPoints>1000</MaxHitPoints>
            <Flammability>0</Flammability>
            <Mass>100</Mass>
            <Beauty>-5</Beauty>
            <WorkToBuild>6000</WorkToBuild>
            <MarketValue>2000</MarketValue>
        </statBases>
        <costList>
            <Plasteel>300</Plasteel>
            <Uranium>100</Uranium>
            <Steel>300</Steel>
            <ComponentSpacer>10</ComponentSpacer>
        </costList>
        <tickerType>Normal</tickerType>
        <killedLeavings>
            <ChunkSlagSteel>1</ChunkSlagSteel>
        </killedLeavings>
        <comps>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="TBW.CompProperties_TBW_MultiPawnsHolder">
                <baseMaxPawnNum>6</baseMaxPawnNum>
                <isSuspended>true</isSuspended>
            </li>
            <li Class="TBW.CompProperties_TBW_GarrisonWeapon">
                <mainWeaponDef>TBW_ChargeDefender</mainWeaponDef>
                <autoAttack>true</autoAttack>
                <CDTicksReducePerPawn>1</CDTicksReducePerPawn>
            </li>
        </comps>
    </ThingDef>

